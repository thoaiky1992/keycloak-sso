@baseUrl = http://localhost:4000

# User đăng nhập phải có client role realm-management/manage-clients.
# REST Client đọc tài khoản từ http/.env.
# @name clientAdminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{$dotenv KEYCLOAK_API_ADMIN_USERNAME}}",
  "password": "{{$dotenv KEYCLOAK_API_ADMIN_PASSWORD}}"
}

###

# Chạy clientAdminLogin trước, rồi tạo role cho client có Client ID bên dưới.
POST {{baseUrl}}/api/roles/client
Authorization: Bearer {{clientAdminLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "clientId": "backend-app",
  "name": "client-viewer-{{$timestamp}}",
  "description": "Can view content"
}
